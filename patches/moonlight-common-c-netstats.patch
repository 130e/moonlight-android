+// Cumulative coarse video packet counters for downlink network-loss estimation.
+// "Expected" is booked once per FEC block at block init (so totally-lost frames still
+// count), "received" is incremented per accepted packet. Lost = expected - received.
+// These are read across threads from a JNI getter, so use relaxed atomics (no mutex
+// needed for coarse monotonic counters).
+static atomic_uint_least32_t g_expectedDataPackets;
+static atomic_uint_least32_t g_receivedDataPackets;
+static atomic_uint_least32_t g_expectedParityPackets;
+static atomic_uint_least32_t g_receivedParityPackets;
+
+void LiGetVideoPacketStats(uint32_t* expectedDataPackets, uint32_t* receivedDataPackets,
+                           uint32_t* expectedParityPackets, uint32_t* receivedParityPackets) {
+    if (expectedDataPackets != NULL) {
+        *expectedDataPackets = atomic_load_explicit(&g_expectedDataPackets, memory_order_relaxed);
+    }
+    if (receivedDataPackets != NULL) {
+        *receivedDataPackets = atomic_load_explicit(&g_receivedDataPackets, memory_order_relaxed);
+    }
+    if (expectedParityPackets != NULL) {
+        *expectedParityPackets = atomic_load_explicit(&g_expectedParityPackets, memory_order_relaxed);
+    }
+    if (receivedParityPackets != NULL) {
+        *receivedParityPackets = atomic_load_explicit(&g_receivedParityPackets, memory_order_relaxed);
+    }
+}
+
