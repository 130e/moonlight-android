+
+    // Reset the cumulative packet counters for this session
+    atomic_store_explicit(&g_expectedDataPackets, 0, memory_order_relaxed);
+    atomic_store_explicit(&g_receivedDataPackets, 0, memory_order_relaxed);
+    atomic_store_explicit(&g_expectedParityPackets, 0, memory_order_relaxed);
+    atomic_store_explicit(&g_receivedParityPackets, 0, memory_order_relaxed);
 }
 
